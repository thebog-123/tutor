# Replit configuration for The Binder.
# `dev:replit` binds to 0.0.0.0 so Replit's proxy can reach the dev server.
modules = ["nodejs-20"]
run = "npm run dev:replit"

[nix]
channel = "stable-24_05"

# Replit exposes localPort 3000 as the webview URL.
[[ports]]
localPort = 3000
externalPort = 80

[env]
NEXT_TELEMETRY_DISABLED = "1"

# "Deploy" builds and serves the production bundle instead of the dev server.
[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start:replit"]
