# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-side only. Used to create accounts (there is no
# self-signup) and by the seed script. Never expose this to the browser and
# never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: password the seed script sets on every demo account.
# SEED_PASSWORD=binder-demo-2024
