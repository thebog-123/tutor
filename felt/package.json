    "stack:stop": "bash scripts/local-stack.sh stop"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsonwebtoken": "^9.0.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
